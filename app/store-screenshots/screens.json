{
  "locales": ["ja", "en"],
  "devices": {
    "iphone": { "device_type": "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max", "size": [1320, 2868] },
    "ipad": { "device_type": "com.apple.CoreSimulator.SimDeviceType.iPad-Pro-13-inch-M5-12GB", "size": [2064, 2752] }
  },
  "screens": [
    {
      "id": "01-timer",
      "args": ["-SeedSampleStats"],
      "copy": { "ja": ["今日も一歩、", "集中の種を蒔く"], "en": ["One step today,", "one seed of focus"] }
    },
    {
      "id": "02-growing",
      "args": ["-SeedSampleStats", "-LeafPattern=big", "-AutoStart"],
      "copy": { "ja": ["毎日の積み重ねが、", "大きな木に"], "en": ["Small daily sessions", "grow a big tree"] }
    },
    {
      "id": "03-history",
      "args": ["-SeedSampleStats", "-InitialScreen=history"],
      "copy": { "ja": ["続けた日々が、", "ひと目でわかる"], "en": ["See your streak", "at a glance"] }
    },
    {
      "id": "04-settings",
      "args": ["-SeedSampleStats", "-InitialScreen=settings"],
      "copy": { "ja": ["好みの時間・音で、", "最適な環境を"], "en": ["Your time, your sound,", "your focus zone"] }
    },
    {
      "id": "05-onboarding",
      "args": ["-SeedSampleStats", "-InitialScreen=onboarding"],
      "copy": { "ja": ["集中習慣を", "育てよう"], "en": ["Grow a", "focus habit"] }
    }
  ]
}
