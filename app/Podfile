platform :ios, '17.0'
use_frameworks!
inhibit_all_warnings!

target 'LeafTimer' do

  # Pods for LeafTimer - Updated for iOS 17 and Xcode 15
  pod 'Firebase/Analytics', '~> 10.0'
  pod 'Google-Mobile-Ads-SDK', '~> 11.0'

  target 'LeafTimerTests' do
    inherit! :search_paths
    # Pods for testing (Issue #149 / CLAUDE.md ルール 43)
    # 制約を入れる理由: 引数なしの `bundle exec pod update` が major 越えまで
    # 一気に上げうる。ViewInspector は patch 差 0.10.2 → 0.10.3 だけで
    # ModernTimerViewSpec の accessibility テスト 2 件の結果が変わった実例が
    # あるため (#73 / PR #150)、ViewInspector のみ下限を 0.10.3 まで引き上げる。
    # 注意: `~> 0.10.3` は `>= 0.10.3, < 0.11.0` を意味し、0.10.4 以降の patch は
    # 素通りする (patch を完全に固定するものではない) — 実際の固定は
    # Podfile.lock が担っており、`bundle exec pod update` を明示的に叩かない
    # 限り上がらない。
    pod 'Quick', '~> 7.6'
    pod 'Nimble', '~> 13.7'
    pod 'ViewInspector', '~> 0.10.3'
  end

end

# Fix deployment target warnings
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Set minimum iOS deployment target to 17.0 for all pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
