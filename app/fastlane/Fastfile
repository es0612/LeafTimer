require_relative '../bin/xcode_precheck'

# シミュレータ名は app/Makefile の SIMULATOR 変数を単一の情報源にする (Issue #80)。
# fastlane の作業ディレクトリは app/fastlane/ なので、__dir__ 起点の絶対パスで
# 親ディレクトリの Makefile を読む (相対パスだと実行位置によって壊れる)。
SIMULATOR_NAME = XcodePrecheck.destination_name(
  File.read(File.expand_path('../Makefile', __dir__))
).freeze

update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"

  lane :unittests do
  scan(
    device: SIMULATOR_NAME,
    clean: true,
    scheme: "LeafTimer"
  )
  end

  # DEPRECATED: TestFlight 配信は Xcode Cloud Workflow に移行済み (Issue #13)。
  # この lane は緊急時 rollback 用に残してある。通常は git push で
  # Xcode Cloud が自動配信する。詳細: docs/ver1_2/xcode-cloud-setup.md
  lane :beta do
    unittests

    increment_build_number
    commit_version_bump(xcodeproj: "LeafTimer.xcodeproj")
    push_to_git_remote

    build_app(workspace: "LeafTimer.xcworkspace", scheme: "LeafTimer")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Push listing metadata only to App Store Connect (binary stays with Xcode Cloud)"
  # 認証必須・本番 ASC に metadata を stage する。CI/自動では実行しない (operator 手動)。
  # 詳細手順は SETUP.md「ASC メタデータ投入」と
  # ~/.claude/skills/asc-metadata-delivery/SKILL.md を参照。
  lane :upload_metadata do
    # 先に metadata を ASC の editable に stage する (skip_binary_upload で binary は触らない)。
    # force は付けない: この lane は人間が手実行する前提なので、本番書き込み前に
    # deliver の HTML プレビューを人間が確認する gate を意図的に残す。
    upload_to_app_store(
      skip_binary_upload: true,   # バイナリは Xcode Cloud 所有
      submit_for_review: false    # ステージのみ。提出は意図的な別操作
    )
    # precheck はローカルではなく ASC 側 (editable) を検証する (metadata_path オプション無し)。
    # よって upload の後に呼び、いま stage したコピーを人間 submit 前に検証する。
    precheck
  end
end